# Provedor do modelo de GERAÇÃO (agente, guards e ingestão: estruturadores, data e visão das grades): "gemini" (default) ou "openai".
# O EMBEDDING nunca troca de provedor: segue no gemini-embedding-001, senão a base vetorial
# (18 mil chunks) é invalidada e exigiria re-embed + recalibração do rerank.
LLM_PROVIDER="gemini"
# preencher para usar LLM_PROVIDER="openai" (GPT-5.6 Luna)
OPENAI_API_KEY=""
# override do id do modelo, se ele mudar (default: gpt-5.6-luna)
OPENAI_MODEL=""

# raciocinio do Luna: "none" (default, com temperatura) | "low" | "medium" | "high" (API Responses, sem temperatura)
OPENAI_REASONING=""